{
  "name": "career-compass",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w frontend\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "cd backend && uv run uvicorn app.main:create_app --factory --reload --port 4000",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "cd backend && uv run pytest",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.7.3"
  }
}
