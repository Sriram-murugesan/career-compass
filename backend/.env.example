# ─────────────────────────────────────────────────────────────────────────────
# Career Compass API — environment template
# Copy to backend/.env and fill in. backend/.env is git-ignored: NEVER commit it.
# Every value is validated at startup (app/core/config.py); bad config = no boot.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated frontend origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Pick ONE (the driver is added automatically for postgres URLs):
#   Zero setup (local file):   sqlite+aiosqlite:///./.data/dev.db
#   Docker (docker compose up -d db):
#                              postgresql://career:career@localhost:5432/career_compass
#   Neon (pooled):             postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase (pooler):         postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./.data/dev.db
# Unpooled URL used for migrations (Neon: host WITHOUT "-pooler"; Supabase: port 5432).
# DATABASE_DIRECT_URL=
# true for Neon pooled / Supabase 6543 / PgBouncer (transaction-mode poolers).
DB_PGBOUNCER=false
DB_POOL_SIZE=5
# Apply migrations on startup. Keep true locally; in production run `alembic upgrade head` as a deploy step.
DB_AUTO_MIGRATE=true

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a real one:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Min 32 chars; placeholders are rejected when ENVIRONMENT=production.
JWT_SECRET=dev-only-change-me-to-a-long-random-string-please
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production; must be true when served over HTTPS.
# COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10

# Google sign-in: OAuth "Web application" Client ID(s), comma-separated (not a secret).
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in frontend/.env.local. Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=

# ── LLM key pool ────────────────────────────────────────────────────────────
# Use Groq, OpenRouter, or both. The gateway rotates round robin across EVERY
# key of every provider (alternating providers), and skips keys that are
# rate-limited or failing. No keys at all = agents use offline fallbacks.
# SECRETS: never log, print or commit them.

# Groq — comma-separated keys (gsk_…)
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_LARGE=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b

# OpenRouter — comma-separated keys (sk-or-v1-…). Model ids: https://openrouter.ai/models
# Note: keys on one OpenRouter account share that account's credit.
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_LARGE=openai/gpt-oss-120b
OPENROUTER_MODEL_FAST=openai/gpt-oss-20b
# Optional attribution shown in your OpenRouter dashboard.
# OPENROUTER_SITE_URL=https://your-domain.example
OPENROUTER_APP_NAME=Career Compass

LLM_TIMEOUT_SECONDS=30

# ── Live job listings (Job Search agent) ────────────────────────────────────
# Free, keyless remote-job APIs (no sign-up). Comma-separated: jobicy, remotive.
# Empty = no live postings; the agent shows role suggestions instead.
JOB_BOARDS=jobicy,remotive
# Optional: Adzuna developer keys (free tier, https://developer.adzuna.com) add local,
# city-level listings on top of the remote boards. Leave empty to skip.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country Adzuna searches: in = India, gb, us, ca, au, de, fr, …
JOBS_COUNTRY=in

# ── Shared knowledge graph ──────────────────────────────────────────────────
# A link built from user profiles is shown to other users only when at least this
# many people share it (links from real job postings are always shown).
GRAPH_MIN_USERS=3

# ── Agent memory ────────────────────────────────────────────────────────────
MEMORY_RECALL_LIMIT=5
MEMORY_CONTEXT_BUDGET_CHARS=6000
